GOOGLE_API_KEY=your-key-here
# Use the Gemini Developer API (AI Studio key) instead of Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Free-tier model to use. gemini-2.0-flash lost free tier in 2026.
# Options: gemini-2.5-flash (10 rpm) or gemini-2.5-flash-lite (15 rpm, 1000/day).
GEMINI_MODEL=gemini-2.5-flash
CLINIC_DB_PATH=data/clinic.duckdb
LOG_PATH=logs/audit.jsonl
