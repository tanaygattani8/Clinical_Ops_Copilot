# --- LLM provider: "groq" (default, free, no card) or "gemini" ---
LLM_PROVIDER=groq

# Groq (default). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Gemini (only used if LLM_PROVIDER=gemini). Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash
CLINIC_DB_PATH=data/clinic.duckdb
LOG_PATH=logs/audit.jsonl
