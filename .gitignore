# Secrets — NEVER commit the real .env (only .env.example is committed)
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/

# Local data & logs (regenerated by data/seed.py and at runtime)
data/*.duckdb
data/*.duckdb.wal
logs/*.jsonl

# Local-only deliverables — not pushed (video lives on YouTube; slides/card are working assets)
*.mp4
video_assets/
docs/card.html

# Local-only working notes
CHANGES.md

# setuptools build artifacts
build/

# Knowledge-graph build output (local artifact, regenerated on demand)
graphify-out/

# Local-only review reports
REVIEW_PONYTAIL.md
CHALLENGE_REPORT.md
