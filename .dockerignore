# Keep the image small and Linux-clean. README.md is NOT ignored — the build needs it.
.venv/
venv/
.git/
.gitignore
__pycache__/
*.egg-info/
.pytest_cache/
tests/
data/*.duckdb
data/*.duckdb.wal
logs/*.jsonl
.env

# Local-only deliverables — never needed at runtime, keep them out of the image
*.mp4
video_assets/
docs/
build/
